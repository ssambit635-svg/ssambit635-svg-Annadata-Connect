# Copy to keystore.properties (same folder) and fill in to produce a signed
# release AAB/APK:  cd frontend/android && ./gradlew bundleRelease
# Generate a keystore once with:
#   keytool -genkeypair -v -keystore annadata-release.jks -alias annadata \
#     -keyalg RSA -keysize 2048 -validity 10000
# NEVER commit keystore.properties or the .jks file (see .gitignore).
storeFile=annadata-release.jks
storePassword=CHANGE_ME
keyAlias=annadata
keyPassword=CHANGE_ME
