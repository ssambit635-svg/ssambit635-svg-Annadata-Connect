# Same-origin /api calls are recommended (including remote live previews).
# Leave empty when Express serves the frontend. Only set an HTTPS public API
# origin when the production frontend is hosted separately.
VITE_API_BASE_URL=

# Vite's server-side proxy target, never used by browser-facing code.
API_PROXY_TARGET=http://127.0.0.1:5000

# Google client ID is configured ONCE in backend/.env (GOOGLE_CLIENT_ID).
# /api/auth/options supplies the public client ID to the frontend at runtime.
# No Google secret, SMS credential, or SMTP password belongs in VITE_* variables.
