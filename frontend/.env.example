# Annadata Connect frontend configuration
#
# Backend API base URL used by the Vite dev-server proxy AND by the app in
# production when the frontend is hosted separately from the backend.
# Leave EMPTY to call the API on the same origin (recommended when the
# backend serves the frontend build — the single-port deployment).
VITE_API_BASE_URL=http://localhost:5000

# ---- Google Sign-In ----
# OPTIONAL. Your Google OAuth client id (Google Identity Services).
# While empty, the login page shows the built-in demo account chooser so the
# Google flow works without registering OAuth credentials.
VITE_GOOGLE_CLIENT_ID=
