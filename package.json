{
  "name": "annadata-connect",
  "version": "1.0.0",
  "private": true,
  "description": "Annadata Connect - crop procurement token & queue management (React + Express)",
  "scripts": {
    "setup": "npm --prefix backend install && npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "data:agmarknet": "node scripts/build-agmarknet-sample.mjs",
    "data:agmarknet:levels": "node scripts/build-agmarknet-levels.mjs",
    "data:agmarknet:all": "node scripts/build-agmarknet-sample.mjs && node scripts/build-agmarknet-levels.mjs"
  }
}
