# Copy to backend/.env. Never commit real credentials.
PORT=5000
NODE_ENV=development
# Required in production: generate with `openssl rand -hex 32`.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
CORS_ORIGIN=
# Exact trusted proxy hop count. Leave 0 for direct/local access.
# Set 1 only behind one trusted reverse proxy, with no direct public API access.
TRUST_PROXY=0
SEED_ON_BOOT=true
# False recommended. Opt in only for isolated sample-data demos, NEVER real users.
ALLOW_DEMO_LOGIN=false
# Optional absolute JSON store path; default backend/data/db.json.
DATA_FILE=

# ---- Real Google sign-in (all roles) ----
# OAuth 2.0 Web Application client ID from Google Cloud Console.
# Add the frontend's exact HTTPS origin under Authorized JavaScript origins.
# The frontend reads this public ID from /api/auth/options at runtime.
# Empty means unavailable, NEVER a fake Google account chooser.
GOOGLE_CLIENT_ID=

# ---- Real SMS sign-in (separate from notification SMS below) ----
# none | twilio-verify. No simulated OTP option exists.
AUTH_SMS_PROVIDER=none
# Create a Twilio Verify Service with a 6-digit SMS code.
TWILIO_VERIFY_SERVICE_SID=
SMS_TWILIO_SID=
SMS_TWILIO_AUTH_TOKEN=

# ---- Real email OTP (all roles, including farmers) ----
# none | smtp. Use an authenticated SMTP provider and verified sender/domain.
AUTH_EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS on port 465; false for mandatory STARTTLS on 587.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Procurement notification SMS (NOT login codes) ----
# none | sim | msg91 | twilio. sim records notifications in the staff outbox.
# This setting never enables SMS authentication or exposes OTPs.
SMS_PROVIDER=sim
SMS_MSG91_AUTH_KEY=
SMS_MSG91_SENDER_ID=ADCONE
# Twilio notification sender; Verify does not require this field.
SMS_TWILIO_FROM=
