# Copy to backend/.env. No sign-in credentials are needed: auth is fully mocked.
PORT=5000
NODE_ENV=development
# Required in production: generate with `openssl rand -hex 32`.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
CORS_ORIGIN=
# Exact trusted proxy hop count. Leave 0 for direct/local access.
# Set 1 only behind one trusted reverse proxy, with no direct public API access.
TRUST_PROXY=0
SEED_ON_BOOT=true
# Optional absolute JSON store path; default backend/data/db.json.
DATA_FILE=

# ---- Mocked sign-in (no Google / Twilio / SMTP setup) ----
# Sample accounts are the mock data, so they stay usable. Set false to hide the
# "Explore demo accounts" panel and disable password login for sample accounts;
# the mock Google picker and mock OTP codes keep working either way.
ALLOW_DEMO_LOGIN=true

# ---- Procurement notification SMS (NOT login codes) ----
# none | sim | msg91 | twilio. sim records notifications in the staff outbox.
# This only affects procurement messages; authentication never uses it.
SMS_PROVIDER=sim
SMS_MSG91_AUTH_KEY=
SMS_MSG91_SENDER_ID=ADCONE
SMS_TWILIO_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=
