# Annadata Connect backend configuration
# Copy this file to .env and adjust values for your environment.

# Port the API listens on
PORT=5000

# Secret used to sign JWT tokens. CHANGE THIS in production.
JWT_SECRET=change-me-in-production
# Token validity
JWT_EXPIRES_IN=12h

# Allowed browser origin for CORS (the frontend URL).
# Leave empty to allow any origin (development convenience only).
CORS_ORIGIN=

# Seed the JSON database with demo data on first boot if empty (true/false)
SEED_ON_BOOT=true

# ---- SMS delivery ----
# none | sim | msg91 | twilio
#   sim    = default: every SMS is recorded and shown in the officer dashboard's
#            SMS Outbox (and console) — no external calls.
#   msg91  = real transactional SMS in India (needs MSG91 account + DLT template).
#   twilio = real SMS via Twilio.
SMS_PROVIDER=sim
# MSG91 settings (https://msg91.com → API keys → SMS)
SMS_MSG91_AUTH_KEY=
SMS_MSG91_SENDER_ID=ADCONE
# Twilio settings
SMS_TWILIO_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=

# Environment: development | production
NODE_ENV=development
